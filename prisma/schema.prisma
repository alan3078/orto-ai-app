// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Core Models (camelCase to match existing codebase & earlier migrations)
// ----------------------------------------------------------------------------

// Staff: Scheduling & HR data. Always linked 1:1 with User.
// - name/email derived from User (master)
// - Soft delete: set deletedAt instead of hard delete
// - When User is soft-deleted, Staff is also soft-deleted (handled in app logic)
model Staff {
  id           String      @id @default(cuid())
  visibleId    String      @unique @map("visible_id") // Display ID shown in UI (e.g., "S001")
  rank         String?     // SNO, SRN, RN, RN-CW, etc.
  isActive     Boolean     @default(true) @map("is_active")
  staffGroupId String?     @map("staff_group_id")
  staffGroup   StaffGroup? @relation(fields: [staffGroupId], references: [id])
  shifts       Shift[]
  leaves       Leave[]     // Leave records (FN/ADM/LVE/001)
  // Extended attributes (FN/ADM/STF/007)
  gender          Gender?    @map("gender")
  staffRoles      StaffRole[]
  // 1:1 required link to User (User is master for name/email)
  userId       String      @unique @map("user_id")
  user         User        @relation(fields: [userId], references: [id])
  // Soft delete
  deletedAt    DateTime?   @map("deleted_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  @@index([visibleId])
  @@index([isActive])
  @@index([staffGroupId])
  @@index([rank])
  @@index([deletedAt])
  @@map("staff")
}

// --------------------------------------------------------------------------
// Extended Staffing & Shift Definitions (FN/ADM/STF/007)
// --------------------------------------------------------------------------

enum Gender {
  F
  M
}

model Role {
  id         String      @id @default(cuid())
  name       String      @unique
  order      Int         @unique
  isActive   Boolean     @default(true) @map("is_active")
  staffRoles StaffRole[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("role")
}

model StaffRole {
  staffId    String   @map("staff_id")
  roleId     String   @map("role_id")
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([staffId, roleId])
  @@index([roleId])
  @@map("staff_role")
}

model ShiftDefinition {
  id              String   @id @default(cuid())
  code            String   @unique
  startMinutes    Int      @map("start_minutes")
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("shift_definition")
}

model ShiftDefinitionAudit {
  id              String   @id @default(cuid())
  code            String
  startMinutes    Int      @map("start_minutes")
  durationMinutes Int      @map("duration_minutes")
  deletedAt       DateTime @default(now()) @map("deleted_at")
  deletedBy       String?  @map("deleted_by")
  reason          String?  @map("reason")

  @@map("shift_definition_audit")
}

// New StaffGroup table created with snake_case in prior migration; map fields
model StaffGroup {
  id          String   @id @default(cuid())
  name        String
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")

  staff       Staff[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("staff_group")
}

model Constraint {
  id          String     @id @default(cuid())
  name        String
  description String?
  type        String     // point | vertical_sum | horizontal_sum | sliding_window
  config      Json
  isActive    Boolean    @default(true) @map("is_active")
  isRequired  Boolean    @default(true) @map("is_required") // Hard (true) vs Soft (false) constraint
  priority    Int        @default(0)
  shiftType   ShiftType? @map("shift_type") // null = GLOBAL (applies to all), APN or DAY_NIGHT = specific
  rosters     Roster[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@index([type])
  @@index([isActive])
  @@index([shiftType])
  @@map("constraint")
}

model Roster {
  id            String       @id @default(cuid())
  name          String
  startDate     DateTime     @map("start_date")
  endDate       DateTime     @map("end_date")
  status        RosterStatus @default(PENDING)
  shiftType     ShiftType    @default(APN) @map("shift_type")
  solveTimeMs   Float?       @map("solve_time_ms")
  solverStatus  String?      @map("solver_status")
  errorMessage  String?      @db.Text @map("error_message")
  timeSlots     Int          @map("time_slots")
  states        Json
  shifts        Shift[]
  constraints   Constraint[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([startDate, endDate])
  @@index([shiftType])
  @@map("roster")
}

enum RosterStatus {
  PENDING
  SOLVING
  COMPLETED
  FAILED
  INFEASIBLE
}

enum ShiftType {
  APN       // Afternoon, PM, Night (0=Off, 1=A, 2=P, 3=N)
  SEVEN_E   // 7E: Day (7) and Night (E) 12h shifts (0=Off, 1=7, 2=E)
}

// Configuration settings for each shift type (min/max working hours, etc.)
model ShiftTypeConfig {
  id            String    @id @default(cuid())
  shiftType     ShiftType @unique @map("shift_type")
  name          String    // Human-readable name (e.g., "APN Shift", "Day/Night Shift")
  description   String?
  minHoursPerMonth Int    @default(160) @map("min_hours_per_month")  // Minimum working hours per month
  maxHoursPerMonth Int    @default(190) @map("max_hours_per_month")  // Maximum working hours per month
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("shift_type_config")
}

model Shift {
  id         String   @id @default(cuid())
  rosterId   String   @map("roster_id")
  roster     Roster   @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  staffId    String   @map("staff_id")
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  timeSlot   Int      @map("time_slot")
  state      Int
  date       DateTime
  notes      String?
  isIC       Boolean  @default(false) @map("is_ic")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([rosterId, staffId, timeSlot])
  @@index([rosterId, timeSlot])
  @@index([staffId, date])
  @@map("shift")
}

// ----------------------------------------------------------------------------
// System Configuration Models
// ----------------------------------------------------------------------------

enum SystemConfigScope {
  GLOBAL
  ROSTER
}

model SystemConfigGroup {
  id        Int               @id @default(autoincrement())
  code      String            @unique // stable identifier e.g. core_global, roster_management
  name      String
  scope     SystemConfigScope
  isActive  Boolean           @default(true) @map("is_active")
  locked    Boolean           @default(false)
  items     SystemConfigItem[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@index([scope])
  @@index([isActive])
  @@map("system_config_group")
}

model SystemConfigItem {
  id         Int               @id @default(autoincrement())
  groupId    Int               @map("group_id")
  group      SystemConfigGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  key        String            // machine key within group (unique per group)
  label      String            // human readable label
  type       String            // semantic type e.g. nurse_safety, pattern_block
  value      Json              // JSON value payload
  priority   Int               @default(0)
  isActive   Boolean           @default(true) @map("is_active")
  locked     Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@unique([groupId, key])
  @@index([isActive])
  @@index([type])
  @@map("system_config_item")
}

// ----------------------------------------------------------------------------
// User Authentication Models (FN/ADM/AUTH/001 & AUTH/002)
// ----------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN  // Full system access: global config, all features
  ADMIN        // Manager access: roster management, staff management (no system config)
  USER         // Staff access: view roster, submit requests
}

// User: Authentication & master identity. Always linked 1:1 with Staff.
// - username for login, email for password reset
// - name is the display name (source of truth, Staff derives from here)
// - Soft delete: set deletedAt instead of hard delete
// - When deleted, both User and Staff get deletedAt set (handled in app logic)
model User {
  id               String    @id @default(cuid())
  username         String    @unique                    // Login identifier
  email            String?   @unique                    // For password reset only
  passwordHash     String    @map("password_hash")
  name             String                               // Display name
  role             UserRole  @default(USER)
  isActive         Boolean   @default(true) @map("is_active")
  mustResetPassword Boolean  @default(true) @map("must_reset_password")
  tosAcceptedAt    DateTime? @map("tos_accepted_at")
  lastLoginAt      DateTime? @map("last_login_at")
  staff            Staff?    // 1:1 backlink (Staff has the FK)
  // Soft delete
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([username])
  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("user")
}

// ----------------------------------------------------------------------------
// Dynamic Permission System (FN/ADM/AUTH/002)
// ----------------------------------------------------------------------------

// Module: Represents a feature module in the system (e.g., Staff, Roster, Config)
model PermissionModule {
  id          String       @id @default(cuid())
  code        String       @unique  // e.g., "staff", "roster", "system_config"
  name        String                // e.g., "Staff Management"
  description String?
  icon        String?               // Lucide icon name for UI
  sortOrder   Int          @default(0) @map("sort_order")
  isActive    Boolean      @default(true) @map("is_active")
  permissions Permission[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([sortOrder])
  @@map("permission_module")
}

// Permission: Specific actions within a module (e.g., staff:create, staff:read)
model Permission {
  id          String            @id @default(cuid())
  moduleId    String            @map("module_id")
  module      PermissionModule  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  code        String            @unique  // e.g., "staff:create", "staff:read", "config:global:edit"
  name        String                     // e.g., "Create Staff"
  description String?
  action      String                     // create, read, update, delete, or custom actions
  sortOrder   Int               @default(0) @map("sort_order")
  isActive    Boolean           @default(true) @map("is_active")
  rolePermissions RolePermission[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([moduleId, action])
  @@index([isActive])
  @@index([action])
  @@map("permission")
}

// RolePermission: Maps UserRole to Permission (which role has which permission)
model RolePermission {
  id           String     @id @default(cuid())
  role         UserRole
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  isGranted    Boolean    @default(true) @map("is_granted")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([role, permissionId])
  @@index([role])
  @@index([permissionId])
  @@map("role_permission")
}

// ----------------------------------------------------------------------------
// Leave Management Models (FN/ADM/LVE/001)
// ----------------------------------------------------------------------------

enum LeaveType {
  SL  // Sick Leave
  PH  // Public Holiday
  AL  // Annual Leave
  UL  // Unpaid Leave
  ML  // Maternity Leave
  CL  // Compassionate Leave
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// Leave: Staff leave records (sick leave, annual leave, etc.)
model Leave {
  id        String      @id @default(cuid())
  staffId   String      @map("staff_id")
  staff     Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startDate DateTime    @map("start_date")
  endDate   DateTime    @map("end_date")
  leaveType LeaveType   @map("leave_type")
  status    LeaveStatus @default(APPROVED)
  notes     String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@index([staffId])
  @@index([startDate, endDate])
  @@index([leaveType])
  @@index([status])
  @@map("leave")
}

// PublicHoliday: Hong Kong public holidays calendar
model PublicHoliday {
  id          String   @id @default(cuid())
  date        DateTime
  name        String
  year        Int
  isRecurring Boolean  @default(false) @map("is_recurring")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([date])
  @@index([year])
  @@map("public_holiday")
}
